(version 1)

# The USB-C receptacle's two locating pegs sit 0.19 mm from its own ground pads.
# That spacing is part of the manufacturer's land pattern, so it is accepted here
# while the 0.25 mm hole clearance still applies everywhere else on the board.
(rule "USB-C locating pegs"
	(condition "A.memberOfFootprint('J3') && B.memberOfFootprint('J3')")
	(constraint hole_clearance (min 0.15mm)))
